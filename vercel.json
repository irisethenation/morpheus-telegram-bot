{
  "version": 2,
  "builds": [
    { "src": "api/webhook.js",          "use": "@vercel/node" },
    { "src": "api/publish.js",          "use": "@vercel/node" },
    { "src": "api/cron/social-post.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/webhook",            "dest": "api/webhook.js" },
    { "src": "/api/publish",            "dest": "api/publish.js" },
    { "src": "/api/cron/social-post",   "dest": "api/cron/social-post.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/social-post",
      "schedule": "0 9 * * *"
    }
  ],
  "env": {
    "TELEGRAM_BOT_TOKEN_MORPHEUS": "8251575468:AAEs0bvHWRAFuC3JoA2oQrGFBpfT9s0TcWs",
    "TELEGRAM_BOT_TOKEN_TRINITY":  "841865554:AAEbHF20QPm0z-WZa25R50kJNt0vfreG5yY",
    "MORPHEUS_AGENT_ENDPOINT":     "https://api.irise.academy/morpheus/v1/agents/spawn",
    "BREVO_API_KEY":               "YOUR_BREVO_API_KEY_HERE",
    "STRIPE_SECRET_KEY":           "YOUR_STRIPE_KEY_HERE",
    "IRISE_CHANNEL_ID":            "YOUR_TELEGRAM_CHANNEL_ID_HERE",
    "PUBLISH_SECRET":              "YOUR_PUBLISH_SECRET_HERE",
    "CRON_SECRET":                 "YOUR_CRON_SECRET_HERE",
    "ANTHROPIC_API_KEY":           "YOUR_ANTHROPIC_API_KEY_HERE",
    "TRYPOST_URL":                 "https://social.irise.academy",
    "TRYPOST_API_KEY":             "YOUR_TRYPOST_API_KEY_HERE"
  }
}
