# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=morpheus
PG_USER=morpheus
PG_PASSWORD=your_pg_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Anthropic (Claude) — LLM routing for agents
ANTHROPIC_API_KEY=your_anthropic_key_here

# Telegram bots (for response dispatch back to users)
TELEGRAM_BOT_TOKEN_MORPHEUS=your_morpheus_token_here
TELEGRAM_BOT_TOKEN_TRINITY=your_trinity_token_here

# Internal API auth — shared secret between Telegram bot and this server
INTERNAL_API_SECRET=your_strong_secret_here

# Stripe
STRIPE_SECRET_KEY=your_stripe_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Brevo (email automation)
BREVO_API_KEY=your_brevo_key_here
BREVO_FROM_EMAIL=no-reply@irise.nation
# Template IDs (set after creating templates in Brevo dashboard)
BREVO_TPL_WELCOME=
BREVO_TPL_INTAKE=
BREVO_TPL_PAYMENT=
BREVO_TPL_ENROLLMENT=
BREVO_TPL_FOLLOW_UP=
BREVO_TPL_UPSELL=
# List IDs
BREVO_LIST_ALL=
BREVO_LIST_CLIENTS=
BREVO_LIST_ACADEMY=

# CRM external sync (optional — HubSpot, Pipedrive, or custom endpoint)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Twilio (SMS + Voice outreach)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+447700000000

# VAPI (AI calling)
VAPI_API_KEY=your_vapi_api_key
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
VAPI_ASSISTANT_AGENCY=your_vapi_assistant_id_for_agency
VAPI_ASSISTANT_PROPERTY=your_vapi_assistant_id_for_property
VAPI_ASSISTANT_ACADEMY=your_vapi_assistant_id_for_academy

# Property Comps API (propertydata.co.uk or equivalent)
PROPERTY_COMPS_API_KEY=your_property_comps_api_key

# WePayCash frontend origin
WEPAY_CASH_ORIGIN=https://wepaycash.co.uk

# GEM Agency frontend origin
GEM_AGENCY_ORIGIN=https://gemagency.co.uk
