# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=morpheus
PG_USER=morpheus
PG_PASSWORD=your_pg_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Anthropic (Claude) — LLM routing for agents
ANTHROPIC_API_KEY=your_anthropic_key_here

# Telegram bots (for response dispatch back to users)
TELEGRAM_BOT_TOKEN_MORPHEUS=your_morpheus_token_here
TELEGRAM_BOT_TOKEN_TRINITY=your_trinity_token_here

# Internal API auth — shared secret between Telegram bot and this server
INTERNAL_API_SECRET=your_strong_secret_here

# Stripe
STRIPE_SECRET_KEY=your_stripe_key_here

# Brevo (email)
BREVO_API_KEY=your_brevo_key_here

# WePayCash frontend origin
WEPAY_CASH_ORIGIN=https://wepaycash.co.uk

# GEM Agency frontend origin
GEM_AGENCY_ORIGIN=https://gemagency.co.uk
