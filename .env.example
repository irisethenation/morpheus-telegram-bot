# ─── TELEGRAM ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN_MORPHEUS=     # From @BotFather — revoke and replace after any exposure
TELEGRAM_BOT_TOKEN_TRINITY=      # Trinity bot token
TRINITY_ADMIN_CHAT_ID=           # Your Telegram numeric user/group ID (get from @userinfobot)

# ─── OVHCloud Morpheus API (51.79.29.15:19000) — managed by Mapondera ────────
MORPHEUS_API_URL=http://51.79.29.15:19000
MORPHEUS_API_KEY=                # OVH API key — set in Vercel dashboard only

# ─── Payment database (morpheus_core PostgreSQL) ──────────────────────────────
# The OVH PostgreSQL must be accessible externally (enable external port in docker-compose)
# Or use a separate externally-accessible Postgres (Neon free tier works)
PAYMENT_DB_URL=                  # postgresql://user:pass@host:port/morpheus_core
PAYMENT_DB_SSL=true              # set false if connecting over private network

# ─── Payment webhooks ─────────────────────────────────────────────────────────
TIDE_WEBHOOK_SECRET=             # HMAC secret — set in your Tide poller / n8n workflow
STRIPE_WEBHOOK_SECRET=           # From Stripe dashboard → Webhooks (whsec_...) — dormant until verified
                                 # Add /api/stripe-webhook as endpoint in Stripe dashboard

# ─── AgentMail — inbound reply tracking + agent email inbox ─────────────────
AGENTMAIL_API_KEY=               # am_us_inbox_... from agentmail.to dashboard
                                 # Register /api/agentmail-webhook in AgentMail → Webhooks

# ─── Resend email delivery ────────────────────────────────────────────────────
RESEND_API_KEY=                  # From resend.com/api-keys — free tier: 3,000 emails/month
RESEND_FROM_EMAIL=               # e.g. GEM The Agency <morpheus@gemtheagency.com>
RESEND_WEBHOOK_SECRET=           # From Resend dashboard → Webhooks (whsec_...)
                                 # Add /api/resend-events as endpoint in Resend dashboard

# ─── OpenRouter LLM routing — Dolphin (legal) + Gemma (general) ──────────────
OPENROUTER_API_KEY=              # From openrouter.ai/keys — replace after any exposure

# ─── Site ─────────────────────────────────────────────────────────────────────
GEM_AGENCY_URL=https://gemtheagency.com
