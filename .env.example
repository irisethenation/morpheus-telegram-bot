# ============================================================
# MORPHEUS STACK — Environment Variables Reference
# ============================================================
# Copy this file to .env for local dev (never commit .env).
# In production: set all values in the Vercel dashboard under
# Settings → Environment Variables.
# ============================================================

# Telegram bot tokens — obtain from @BotFather
TELEGRAM_BOT_TOKEN_MORPHEUS=
TELEGRAM_BOT_TOKEN_TRINITY=

# Morpheus agent API (self-hosted on OVH)
MORPHEUS_AGENT_ENDPOINT=https://api.irise.academy/morpheus/v1/agents/spawn

# Telegram channel to publish content to
# Use numeric ID (e.g. -1001234567890) or @channel_handle
IRISE_CHANNEL_ID=

# Auth secrets — generate with: openssl rand -hex 32
PUBLISH_SECRET=
CRON_SECRET=

# TryPost — self-hosted at social.irise.academy
TRYPOST_URL=https://social.irise.academy
TRYPOST_API_KEY=

# Anthropic Claude API (optional — enables AI post generation)
ANTHROPIC_API_KEY=

# Email — EmailAgent is locked by default; set when operator unlocks
BREVO_API_KEY=

# Payments — set when Stripe integration is activated
STRIPE_SECRET_KEY=
