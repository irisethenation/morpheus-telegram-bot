# ─── Automatisch Core ─────────────────────────────────────────────────────────
APP_ENV=production
HOST=https://automatisch.irise.academy
PORT=3000

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_32_char_random_hex_string_here_0000
APP_SECRET_KEY=replace_with_another_32_char_random_hex_here_000
WEBHOOK_SECRET_KEY=replace_with_yet_another_random_secret_here_000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_DATABASE=automatisch
POSTGRES_USERNAME=automatisch
POSTGRES_PASSWORD=choose_a_strong_password_here

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Automatisch Admin User (first run only) ──────────────────────────────────
INITIAL_USER_EMAIL=admin@irise.academy
INITIAL_USER_PASSWORD=choose_a_strong_admin_password

# ─── Telegram (for admin alert actions inside flows) ─────────────────────────
# Your personal admin Telegram chat ID (get from @userinfobot)
ADMIN_TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Brevo / Sendinblue (Email + Contact Management) ─────────────────────────
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_LEAD_LIST_ID=1
BREVO_STUDENT_LIST_ID=2
BREVO_TRUST_CLIENT_LIST_ID=3
BREVO_WELCOME_TEMPLATE_ID=1
BREVO_INTAKE_CONFIRM_TEMPLATE_ID=2
BREVO_ENROLLMENT_TEMPLATE_ID=3
BREVO_TRUST_ORDER_TEMPLATE_ID=4

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Stripe Price IDs
STRIPE_PRICE_TRUST_FOUNDATIONAL=price_xxx
STRIPE_PRICE_TRUST_ESTATE=price_xxx
STRIPE_PRICE_TRUST_LEGACY=price_xxx
STRIPE_PRICE_ACADEMY_AGNOTOLOGY=price_xxx
STRIPE_PRICE_ACADEMY_STATUS=price_xxx
STRIPE_PRICE_ACADEMY_TRUST=price_xxx
STRIPE_PRICE_ACADEMY_COMPLETE=price_xxx

# ─── iRise Bot Webhook URLs (set in Vercel env vars) ─────────────────────────
# After creating each flow in Automatisch UI, copy its webhook URL here
# Then add these same values to your Vercel environment variables

FLOW_WEBHOOK_CONTACT_CAPTURE=https://automatisch.irise.academy/webhooks/flow-uuid-contact-capture
FLOW_WEBHOOK_INTAKE=https://automatisch.irise.academy/webhooks/flow-uuid-intake
FLOW_WEBHOOK_TRUST_INQUIRY=https://automatisch.irise.academy/webhooks/flow-uuid-trust
FLOW_WEBHOOK_ACADEMY_INQUIRY=https://automatisch.irise.academy/webhooks/flow-uuid-academy
FLOW_WEBHOOK_ADMIN_ALERT=https://automatisch.irise.academy/webhooks/flow-uuid-admin-alert
FLOW_WEBHOOK_STRIPE_PAYMENT=https://automatisch.irise.academy/webhooks/flow-uuid-stripe

# Shared secret for validating webhook calls from the bot
AUTOMATISCH_WEBHOOK_SECRET=choose_a_shared_secret_between_bot_and_automatisch
